{
  "name": "Retail",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "tables": [
      {
        "name": "Store",
        "columns": [
          {
            "name": "StoreID",
            "sourceColumn": "StoreID",
            "dataType": "int64",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Store",
            "sourceColumn": "Store",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "City",
            "sourceColumn": "City",
            "dataType": "string",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Store",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Bytes = Binary.Decompress(Binary.FromText(storesSnapshot, BinaryEncoding.Base64), Compression.Deflate),",
                "    Rows = Csv.Document(Bytes, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Rows, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"StoreID\", Int64.Type}, {\"Store\", type text}, {\"City\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Sales",
        "columns": [
          {
            "name": "StoreID",
            "sourceColumn": "StoreID",
            "dataType": "int64",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Month",
            "sourceColumn": "Month",
            "dataType": "dateTime",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "isHidden": true
          },
          {
            "name": "Revenue",
            "sourceColumn": "Revenue",
            "dataType": "decimal",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "ProductCost",
            "sourceColumn": "ProductCost",
            "dataType": "decimal",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Units",
            "sourceColumn": "Units",
            "dataType": "int64",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Lines",
            "sourceColumn": "Lines",
            "dataType": "int64",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Receipts",
            "sourceColumn": "Receipts",
            "dataType": "int64",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Bytes = Binary.Decompress(Binary.FromText(salesSnapshot, BinaryEncoding.Base64), Compression.Deflate),",
                "    Rows = Csv.Document(Bytes, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Rows, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"StoreID\", Int64.Type}, {\"Month\", type date}, {\"Revenue\", Currency.Type}, {\"ProductCost\", Currency.Type}, {\"Units\", Int64.Type}, {\"Lines\", Int64.Type}, {\"Receipts\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Sales amount",
            "expression": "SUM ( Sales[Revenue] )",
            "formatString": "#,0;(#,0);0",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Sales target",
            "expression": "SUM ( Target[Target] )",
            "formatString": "#,0;(#,0);0",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Sales gap",
            "expression": "[Sales amount] - [Sales target]",
            "formatString": "#,0;(#,0);0",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Plan attainment",
            "expression": "DIVIDE ( [Sales amount], [Sales target] )",
            "formatString": "0.0%",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Product cost",
            "expression": "SUM ( Sales[ProductCost] )",
            "formatString": "#,0;(#,0);0",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Gross profit",
            "expression": "[Sales amount] - [Product cost]",
            "formatString": "#,0;(#,0);0",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Gross margin",
            "expression": "DIVIDE ( [Gross profit], [Sales amount] )",
            "formatString": "0.0%",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Operating expense",
            "expression": "SUM ( Expense[Expense] )",
            "formatString": "#,0;(#,0);0",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Store contribution",
            "expression": "[Gross profit] - [Operating expense]",
            "formatString": "#,0;(#,0);0",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Contribution margin",
            "expression": "DIVIDE ( [Store contribution], [Sales amount] )",
            "formatString": "0.0%",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Receipt count",
            "expression": "SUM ( Sales[Receipts] )",
            "formatString": "#,0",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Units sold",
            "expression": "SUM ( Sales[Units] )",
            "formatString": "#,0",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Average receipt",
            "expression": "DIVIDE ( [Sales amount], [Receipt count] )",
            "formatString": "#,0.00",
            "displayFolder": "Trading indicators"
          },
          {
            "name": "Stores meeting plan",
            "expression": "COUNTROWS ( FILTER ( VALUES ( Store[StoreID] ), [Sales target] > 0 && [Sales gap] >= 0 ) ) + 0",
            "formatString": "#,0",
            "displayFolder": "Trading indicators"
          }
        ]
      },
      {
        "name": "Target",
        "columns": [
          {
            "name": "StoreID",
            "sourceColumn": "StoreID",
            "dataType": "int64",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Month",
            "sourceColumn": "Month",
            "dataType": "dateTime",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "isHidden": true
          },
          {
            "name": "Target",
            "sourceColumn": "Target",
            "dataType": "decimal",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Target",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Bytes = Binary.Decompress(Binary.FromText(targetsSnapshot, BinaryEncoding.Base64), Compression.Deflate),",
                "    Rows = Csv.Document(Bytes, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Rows, [PromoteAllScalars=true]),",
                "    Monthly = Table.UnpivotOtherColumns(Headers, {\"StoreID\"}, \"Month\", \"Target\"),",
                "    Typed = Table.TransformColumnTypes(Monthly, {{\"StoreID\", Int64.Type}, {\"Month\", type date}, {\"Target\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Expense",
        "columns": [
          {
            "name": "StoreID",
            "sourceColumn": "StoreID",
            "dataType": "int64",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Month",
            "sourceColumn": "Month",
            "dataType": "dateTime",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd",
            "isHidden": true
          },
          {
            "name": "Expense",
            "sourceColumn": "Expense",
            "dataType": "decimal",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Expense",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Bytes = Binary.Decompress(Binary.FromText(expensesSnapshot, BinaryEncoding.Base64), Compression.Deflate),",
                "    Rows = Csv.Document(Bytes, [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Rows, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"StoreID\", Int64.Type}, {\"Month\", type date}, {\"Expense\", Currency.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Period",
        "columns": [
          {
            "name": "Month",
            "sourceColumn": "Month",
            "dataType": "dateTime",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Year",
            "sourceColumn": "Year",
            "dataType": "string",
            "summarizeBy": "none"
          },
          {
            "name": "YearMonth",
            "sourceColumn": "YearMonth",
            "dataType": "string",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Period",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Months = Table.Distinct(Table.SelectColumns(Sales, {\"Month\"})),",
                "    Years = Table.AddColumn(Months, \"Year\", each Date.ToText([Month], \"yyyy\", \"en-US\"), type text),",
                "    Labels = Table.AddColumn(Years, \"YearMonth\", each Date.ToText([Month], \"yyyy-MM\", \"en-US\"), type text)",
                "in",
                "    Labels"
              ]
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Sales_Store",
        "fromTable": "Sales",
        "fromColumn": "StoreID",
        "toTable": "Store",
        "toColumn": "StoreID",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Sales_Period",
        "fromTable": "Sales",
        "fromColumn": "Month",
        "toTable": "Period",
        "toColumn": "Month",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Expense_Store",
        "fromTable": "Expense",
        "fromColumn": "StoreID",
        "toTable": "Store",
        "toColumn": "StoreID",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Expense_Period",
        "fromTable": "Expense",
        "fromColumn": "Month",
        "toTable": "Period",
        "toColumn": "Month",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Target_Store",
        "fromTable": "Target",
        "fromColumn": "StoreID",
        "toTable": "Store",
        "toColumn": "StoreID",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Target_Period",
        "fromTable": "Target",
        "fromColumn": "Month",
        "toTable": "Period",
        "toColumn": "Month",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "expressions": [
      {
        "name": "storesSnapshot",
        "kind": "m",
        "expression": "\"VdBNDoIwEIbhvaeYA3RBUfxZqmwIakjAA4xatQFb0zYkuPYMHtCTWBQmuGryPt9mmjttRBKzvH3ZWrpmxAPONrWs4f18ccgqtDf8Bi8hSQi5PktRl2RjsjGsUJ2EIZqwtPnRBDL9UA2W8pu8RWQRFPl+2/cp9SkURjfCHq9SYc8z4hmkWdLnOYuVvBvdwhyWrkLluuR1MdAFZGgtXgQxD1h6RVN2pwft7Q/sm3f+5xwKrI0cDsK/QQg7cRBWof8q52+m4Qc=\""
      },
      {
        "name": "salesSnapshot",
        "kind": "m",
        "expression": "\"\""
      },
      {
        "name": "targetsSnapshot",
        "kind": "m",
        "expression": "\"\""
      },
      {
        "name": "expensesSnapshot",
        "kind": "m",
        "expression": "\"\""
      }
    ],
    "annotations": [
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      }
    ]
  }
}
